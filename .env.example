# --- LLM ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=16000
# low | medium | high | xhigh | max — higher is more thorough but slower
LLM_EFFORT=medium

# --- Embeddings / storage ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DATA_DIR=./data

# --- Ingestion limits ---
MAX_FILE_SIZE_MB=10
MAX_PDF_PAGES=200
MAX_FILES_PER_UPLOAD=5
MAX_DOCS_PER_SESSION=20

# --- Sessions / chat ---
SESSION_TTL_HOURS=24
MAX_HISTORY_TURNS=6
MAX_QUESTION_CHARS=2000

# --- Retrieval ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
